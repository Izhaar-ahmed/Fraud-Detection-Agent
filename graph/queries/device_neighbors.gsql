// Cards that used one DeviceProfile in [t_from, t_to], with per-card tallies,
// plus the closed cases on or connected to those cards.
CREATE OR REPLACE QUERY device_neighbors(STRING device_id, STRING t_from, STRING t_to) FOR GRAPH FraudGraph {
  SetAccum<STRING> @@seed_ids;
  SumAccum<INT> @n;
  SumAccum<DOUBLE> @amt;
  MaxAccum<DOUBLE> @max_p;
  SetAccum<STRING> @proxies;
  SetAccum<STRING> @statuses;
  SetAccum<STRING> @txn_ids;
  MinAccum<INT> @first_epoch;
  MaxAccum<INT> @last_epoch;
  SetAccum<STRING> @via_cards;
  DATETIME tf = to_datetime(t_from);
  DATETIME tt = to_datetime(t_to);

  @@seed_ids += device_id;
  devs = to_vertex_set(@@seed_ids, "DeviceProfile");

  txns = SELECT t FROM devs:d -(FROM_DEVICE:e)-> Txn:t
         WHERE t.ts >= tf AND t.ts <= tt;

  cards = SELECT c FROM txns:t -(MADE:e)-> PayCard:c
          ACCUM c.@n += 1,
                c.@amt += t.amt,
                c.@max_p += t.model_p,
                c.@proxies += t.ip_proxy,
                c.@statuses += t.device_status,
                c.@txn_ids += t.id,
                c.@first_epoch += datetime_to_epoch(t.ts),
                c.@last_epoch += datetime_to_epoch(t.ts);

  cc_on = SELECT cc FROM cards:c -(CC_ON_CARD:e)-> ClosedCase:cc
          ACCUM cc.@via_cards += c.id;
  cc_conn = SELECT cc FROM cards:c -(CC_CONNECTED:e)-> ClosedCase:cc
            ACCUM cc.@via_cards += c.id;

  PRINT devs;
  PRINT cards;
  PRINT cc_on[cc_on.id, cc_on.outcome, cc_on.pattern, cc_on.card_id, cc_on.exposure, cc_on.@via_cards];
  PRINT cc_conn[cc_conn.id, cc_conn.outcome, cc_conn.pattern, cc_conn.card_id, cc_conn.exposure, cc_conn.@via_cards];
}
